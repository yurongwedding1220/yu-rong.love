    "react-router-dom": "^7.13.0",
    "three": "~0.182.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.5",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
